# Пример окружения проекта. Скопируйте в `.env` (корень репо) и заполните.
# `.env` в .gitignore; файл читают knowledge-CLI (pnpm rag:*), backend Помощника и review-CLI.

# Провайдер ответов Помощника: deepseek | ollama (по умолчанию deepseek)
ASSISTANT_LLM=deepseek

# Ключ DeepSeek (только backend Помощника и review-CLI; в клиентский бандл не попадает)
DEEPSEEK_API_KEY=

# Модель эмбеддингов Ollama (по умолчанию qwen3-embedding).
# Если в Ollama модель установлена с тегом (например, qwen3-embedding:0.6b), укажите тег явно.
KNOWLEDGE_EMBED_MODEL=qwen3-embedding

# Базовый URL Ollama (по умолчанию http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Путь к базе индекса знаний (по умолчанию .data/knowledge.db относительно корня репо)
# KNOWLEDGE_DB=.data/knowledge.db
