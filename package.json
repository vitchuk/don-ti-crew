{
  "name": "don-ti-crew",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "rag:index": "pnpm --filter @don-ti/knowledge run index",
    "rag:query": "pnpm --filter @don-ti/knowledge run query",
    "review:run": "pnpm -C services/review build && node services/review/dist/cli.js",
    "assistant:dev": "pnpm --filter @don-ti/assistant dev"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "typescript-eslint": "^8.71.2"
  }
}
