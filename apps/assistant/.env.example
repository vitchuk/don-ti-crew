# LLM-провайдер Помощника: deepseek (по умолчанию) или ollama (офлайн-фолбэк)
ASSISTANT_LLM=deepseek

# Ключ DeepSeek API (https://platform.deepseek.com/api_keys).
# Нужен только при ASSISTANT_LLM=deepseek; хранится и используется только на backend.
DEEPSEEK_API_KEY=

# Необязательно: имя модели DeepSeek (по умолчанию deepseek-chat).
# DEEPSEEK_MODEL=deepseek-chat

# Необязательно: путь к базе индекса знаний (по умолчанию .data/knowledge.db в корне репо).
# KNOWLEDGE_DB=
